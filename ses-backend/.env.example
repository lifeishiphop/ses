# 이 파일은 예시입니다. .env로 복사하고 셸에서 불러오세요.
SPRING_PROFILES_ACTIVE=mysql
DB_URL='jdbc:mysql://localhost:3306/ses?serverTimezone=Asia/Seoul&characterEncoding=UTF-8'
DB_USERNAME=ses
DB_PASSWORD=change-me
DDL_AUTO=validate
# openssl rand -base64 64 로 생성한 값을 별도 비밀 설정에 보관하세요.
# JWT_SECRET=

SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
API_DOCS_ENABLED=true

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=ses@localhost
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false

JUDGE_DOCKER_COMMAND=docker
JUDGE_IMAGE=ses-judge:local
JUDGE_MEMORY=512m
JUDGE_COMPILE_TIMEOUT=10s
JUDGE_RUN_TIMEOUT=10s
JUDGE_MAX_CONCURRENT=2
